# simplecov generated
coverage
coverage.data
!coverage/.resultset.json

# rdoc generated
rdoc

# yard generated
doc
.yardoc

# bundler
.bundle

# jeweler generated
pkg

*.gem
Gemfile.lock

# IDE generated
.idea

log/*.log
spec/dummy/log/*.log

# generated by the dummy Rails app on boot
spec/dummy/tmp/*

# scratch db recreated at runtime by MoribusSpecModel, not from schema/migrations
spec/dummy/db/*.sqlite3

# exclude everything in tmp
tmp/*
# except the metric_fu directory
!tmp/metric_fu/
# but exclude everything *in* the metric_fu directory
tmp/metric_fu/*
# except for the _data directory to track metrical outputs
!tmp/metric_fu/_data/
